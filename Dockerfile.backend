# Use rust alpine for building
FROM rust:alpine AS builder

# Install build dependencies
RUN apk add --no-cache musl-dev

WORKDIR /app

# Copy cargo files
COPY backend/Cargo.toml backend/Cargo.lock ./

# Create src directory with dummy main to cache dependencies
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release && rm -rf src

# Copy actual source code
COPY backend/src ./src

# Build the application
RUN touch src/main.rs && cargo build --release

# Runtime stage
FROM alpine:latest

# Install minimal runtime dependencies
RUN apk add --no-cache ca-certificates wget

# Create non-root user
RUN addgroup -g 1000 appgroup && adduser -u 1000 -G appgroup -s /bin/sh -D appuser

# Create directory structure that matches the expected paths
WORKDIR /

# Copy static files to root level (so ../assets and ../posts work from /app)
COPY posts ./posts
COPY assets ./assets

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/backend ./backend

# Change ownership
RUN chown -R appuser:appgroup /app /posts /assets

USER appuser

EXPOSE 8080

CMD ["./backend"]
